{
  "version": "2.0.0",
  "presentation": {
    "echo": true,
    "reveal": "always",
    "focus": false,
    "panel": "shared",
    "showReuseMessage": true,
    "clear": false
  },
  "tasks": [
    {
      "label": "Start Wordflow",
      "type": "shell",
      "command": "vp run dev",
      "problemMatcher": [],
      "isBackground": true
    },
    {
      "label": "Start Backend",
      "type": "shell",
      "command": "vp run dev:backend",
      "problemMatcher": [],
      "isBackground": true
    },
    {
      "label": "Start Frontend",
      "type": "shell",
      "command": "vp run dev:frontend",
      "problemMatcher": [],
      "isBackground": true
    },
    {
      "label": "Compile Tauri App (MacOS)",
      "type": "shell",
      "command": "vp run build:desktop:mac",
      "problemMatcher": []
    },
    {
      "label": "Compile Tauri App (Windows)",
      "type": "shell",
      "command": "vp run build:desktop:windows",
      "problemMatcher": []
    },
    {
      "label": "Test All",
      "type": "shell",
      "command": "cargo test --workspace --locked && vp -C frontend run check",
      "problemMatcher": []
    }
  ]
}
