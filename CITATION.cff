    value: "10.5281/zenodo.20408328"
    description: "The concept DOI: it always resolves to the latest version."
repository-code: "https://github.com/Australian-Text-Analytics-Platform/ldaca-wordflow"
url: "https://sih.tools/wordflow"
license: MIT
keywords:
  - text analytics
  - corpus linguistics
  - concordance
  - topic modelling
  - LDaCA
