# Environment Configuration for LDaCA Web App Backend

# User data folder (relative or absolute path)
DATA_ROOT=data

# Database Configuration (DATABASE_URL optional; if omitted, DB path = DATA_ROOT/DATABASE_FILE)
# DATABASE_URL=sqlite+aiosqlite:///.data/users.db
DATABASE_FILE=users.db
DATABASE_BACKUP_FOLDER=backups

# Data Folders (relative to DATA_ROOT)
USER_DATA_FOLDER=users

# Server Configuration
BACKEND_PORT=8001
DEBUG=false

# Authentication Configuration
# Multi-user mode: true = require Google OAuth, false = single root user
MULTI_USER=false

# Single user configuration (when MULTI_USER=false)
SINGLE_USER_ID=root
SINGLE_USER_NAME=Root User
SINGLE_USER_EMAIL=root@localhost

# Google OAuth Configuration (when MULTI_USER=true)
GOOGLE_CLIENT_ID=your-google-client-id-here

# OIDC sign-in (when MULTI_USER=true): CILogon (AAF), a Keycloak realm, or
# another OIDC provider. The earlier CILOGON_* names are still accepted.
# OIDC_CLIENT_ID and OIDC_CLIENT_SECRET are issued when the client is registered.
# OIDC_REDIRECT_URI must match the callback URL registered with the provider exactly.
OIDC_CLIENT_ID=cilogon:/client_id/your-client-id-here
OIDC_CLIENT_SECRET=your-oidc-client-secret-here
# The provider's exact issuer; Wordflow derives the discovery URL from it:
#   CILogon production: https://cilogon.aaf.edu.au
#   CILogon test:       https://test.cilogon.aaf.edu.au
#   Keycloak realm:     https://sso.example.edu.au/auth/realms/<realm>
OIDC_ISSUER=https://test.cilogon.aaf.edu.au
# Scopes as a JSON list; leave out org.cilogon.userinfo for providers other than CILogon:
# OIDC_SCOPES=["openid","email","profile"]
# Full callback URL that you gave to the provider's administrator, e.g.:
#   https://your-nectar-host.example.com/api/auth/cilogon/callback
OIDC_REDIRECT_URI=https://your-host.example.com/api/auth/cilogon/callback

# Notice shown to every signed-in user (Markdown file, read again when it changes; issue 438)
# SERVER_NOTICE_FILE=/etc/ldaca-wordflow/notice.md

# Security Configuration
TOKEN_EXPIRE_HOURS=24
SECRET_KEY=your-secret-key-here

# Oni API key
ONI_API_KEY=your-oni-api-key-here
