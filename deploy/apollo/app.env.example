# Non-secret environment for Wordflow on Apollo (Run:ai). Copy to app.env.
# Secrets go in Run:ai credentials, never in this file:
#   OIDC_CLIENT_SECRET   Run:ai credential wordflow-oidc
#   APOLLO_LLM_API_KEY   Run:ai credential wordflow-apollo-llm (the LiteLLM key)

MULTI_USER=true

# Sign-in through the Run:ai Keycloak realm (client "wordflow", registered 21 Oct 2026).
# The client accepts exactly this callback; another host needs its own redirect URI.
OIDC_ISSUER=https://gpu.sydney.edu.au/auth/realms/runai
OIDC_CLIENT_ID=wordflow
OIDC_REDIRECT_URI=https://wordflow2026-pilot.gpu.sydney.edu.au/api/auth/cilogon/callback
OIDC_SCOPES=["openid","email","profile"]

SESSION_COOKIE_SECURE=true
TRUSTED_HOSTS=["wordflow2026-pilot.gpu.sydney.edu.au"]
CORS_ALLOWED_ORIGINS=["https://wordflow2026-pilot.gpu.sydney.edu.au"]

# Apollo's AI providers and Topic Modelling GPU (this folder's YAML, mounted read-only).
SERVER_AI_PROVIDERS_FILE=/config/server-ai-providers.yaml
