{
    "$schema": "https://unpkg.com/knip@6/schema.json",
    "entry": [
        "openapi.config.ts",
        "playwright.config.ts",
        "e2e/**/*.spec.ts",
        "src/updater/index.tsx"
    ],
    "project": [
        "src/**/*.{ts,tsx}"
    ],
    "ignore": [
        "src/api/generated/**"
    ],
    "ignoreDependencies": [
        "tw-animate-css",
        "tailwindcss",
        "@tailwindcss/typography"
    ],
    "ignoreBinaries": [
        "uv"
    ],
    "playwright": false
}
