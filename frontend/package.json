{
  "name": "ldaca_wordflow_frontend",
  "version": "8.0.0",
  "description": "LDaCA Wordflow Frontend - React application for text analytics and corpus analysis",
  "type": "module",
  "private": true,
  "homepage": ".",
  "repository": {
    "type": "git",
    "url": "https://github.com/Australian-Text-Analytics-Platform/ldaca-wordflow.git",
    "directory": "ldaca_wordflow/frontend"
  },
  "keywords": [
    "ldaca",
    "text-analytics",
    "corpus-analysis",
    "linguistics",
    "react",
    "vite"
  ],
  "author": "Australian Text Analytics Platform",
  "license": "MIT",
  "dependencies": {
    "@codemirror/view": "^6.43.9",
    "@dagrejs/dagre": "^3.1.1",
    "@mediapipe/tasks-text": "1.0.1",
    "@sentry/react": "^10.71.0",
    "@tanstack/react-query": "^5.102.2",
    "@tanstack/react-table": "^9.1.2",
    "@tanstack/react-virtual": "^3.14.13",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@uiw/react-codemirror": "^4.25.11",
    "@xyflow/react": "^12.11.3",
    "apache-arrow": "^21.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "echarts": "^6.1.0",
    "echarts-wordcloud": "2.1.0",
    "immer": "^11.1.18",
    "jszip": "3.10.2",
    "katex": "^0.18.4",
    "lucide-react": "^1.34.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "sonner": "^2.0.8",
    "sql-formatter": "^15.8.2",
    "stopword": "3.1.5",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.15"
  },
  "scripts": {
    "dev": "vite",
    "dev:tauri": "vite --mode tauri",
    "build": "pnpm theme:check && pnpm theme:audit && tsc --noEmit && vite build && node scripts/verify-build.mjs",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck:tooling && pnpm test && pnpm knip && pnpm build && pnpm docs:check && pnpm versions:check",
    "theme:generate": "node scripts/generate-vscode-theme.mjs",
    "theme:check": "node scripts/generate-vscode-theme.mjs --check",
    "theme:audit": "node scripts/check-theme-contract.mjs",
    "preview": "vite preview",
    "test": "vitest run && node --test scripts/verify-build.test-node.mjs scripts/source-graph.test-node.mjs scripts/sync-language-assets.test-node.mjs scripts/quotation-model.test-node.mjs",
    "prepare:e2e:models": "node scripts/quotation-model.mjs",
    "test:e2e:browser": "wdio run wdio.browser.conf.ts",
    "test:e2e": "pnpm test:e2e:browser",
    "lint": "eslint 'src/**/*.{ts,tsx}' 'e2e-browser/**/*.ts' 'e2e-native/**/*.ts' wdio*.conf.ts vite.config.ts --max-warnings=0",
    "typecheck:tooling": "tsc -p tsconfig.tooling.json --noEmit",
    "knip": "pnpm check:source && knip",
    "format": "biome format --write src/",
    "format:check": "biome format src/",
    "docs:check": "node --experimental-strip-types scripts/check-docs-drift.mjs",
    "docs:sync-publish": "node --experimental-strip-types scripts/sync-published-docs.mjs",
    "versions:check": "node ../scripts/check-versions.mjs && node --test ../scripts/check-versions.test.mjs",
    "tauri": "tauri",
    "tauri:build": "tauri build",
    "clean": "cargo clean --manifest-path ../Cargo.toml",
    "clean:desktop:mac-bundles": "node scripts/clean-desktop-mac-bundles.mjs",
    "compile:desktop:mac-icon": "node scripts/compile-desktop-mac-icon.mjs",
    "dev:desktop": "tauri dev --config src-tauri/tauri.dev.conf.json",
    "build:desktop:mac": "pnpm clean:desktop:mac-bundles && CI=true pnpm tauri:build --config src-tauri/tauri.local-build.conf.json --bundles app,dmg --target aarch64-apple-darwin",
    "build:desktop:windows": "pnpm tauri:build --config src-tauri/tauri.local-build.conf.json",
    "build:quicklook": "node scripts/build-quicklook.mjs",
    "test:quicklook": "node scripts/test-quicklook.mjs",
    "check:source": "node scripts/source-graph.mjs --check",
    "build:e2e:native": "node scripts/native-e2e.mjs build debug",
    "test:e2e:native": "node scripts/native-e2e.mjs test debug",
    "language:assets": "node scripts/sync-language-assets.mjs",
    "build:e2e:native:release": "node scripts/native-e2e.mjs build release",
    "test:e2e:native:release": "node scripts/native-e2e.mjs test release",
    "build:qa:mac": "tauri build --config src-tauri/tauri.local-build.conf.json --bundles app -- --locked",
    "verify:qa:mac": "bash scripts/verify-signed-native.sh \"../target/release/bundle/macos/LDaCA Wordflow.app\" --offline",
    "test:e2e:server": "wdio run wdio.server.conf.ts"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@biomejs/biome": "^2.5.10",
    "@eslint/js": "^10.0.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/eslint-plugin-query": "^5.102.2",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/babel__core": "^7.20.5",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.1.0",
    "@wdio/cli": "^9.30.1",
    "@wdio/globals": "^9.29.1",
    "@wdio/local-runner": "^9.30.1",
    "@wdio/mocha-framework": "^9.30.1",
    "@wdio/spec-reporter": "^9.30.1",
    "@wdio/tauri-plugin": "1.4.0",
    "@wdio/tauri-service": "^1.4.0",
    "@wdio/types": "^9.30.1",
    "ajv": "^8.20.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "eslint-plugin-testing-library": "^7.16.2",
    "expect-webdriverio": "^5.7.0",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "knip": "^6.32.2",
    "mocha": "^10.8.2",
    "msw": "2.15.0",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "webdriverio": "^9.30.1"
  }
}
