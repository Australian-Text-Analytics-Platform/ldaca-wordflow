{
  "productName": "LDaCA Wordflow Test",
  "identifier": "au.edu.ldaca.wordflow.test",
  "bundle": {
    "createUpdaterArtifacts": false,
    "fileAssociations": [],
    "macOS": {
      "files": null
    }
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "capabilities": [
        "default",
        "updater",
        {
          "identifier": "native-tests",
          "windows": [
            "project-*"
          ],
          "permissions": [
            "wdio:default",
            "core:window:allow-close",
            "core:window:allow-set-focus"
          ]
        }
      ]
    }
  },
  "plugins": {
    "updater": {
      "endpoints": []
    }
  },
  "build": {
    "beforeBundleCommand": null,
    "beforeBuildCommand": "pnpm exec tsc -p tsconfig.app.json --noEmit && pnpm exec vp build --mode e2e --outDir .tmp/e2e-build",
    "frontendDist": "../.tmp/e2e-build"
  }
}
