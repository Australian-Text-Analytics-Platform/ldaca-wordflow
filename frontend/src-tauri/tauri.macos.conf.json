{
  "app": {
    "windows": [
      {
        "title": "LDaCA Wordflow",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "width": 1400,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 700,
        "zoomHotkeysEnabled": true,
        "dragDropEnabled": true,
        "visible": false,
        "useHttpsScheme": true,
        "resizable": true,
        "fullscreen": false,
        "transparent": false,
        "create": false
      }
    ]
  },
  "build": {
    "beforeBundleCommand": "pnpm build:quicklook"
  },
  "bundle": {
    "macOS": {
      "files": {
        "PlugIns/WordflowPreview.appex": "target/quicklook/products/WordflowPreview.appex"
      }
    }
  }
}
