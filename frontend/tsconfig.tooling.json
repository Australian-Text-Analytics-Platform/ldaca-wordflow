{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "lib": [
      "ESNext",
      "DOM"
    ],
    "types": [
      "node",
      "vite-plus/client",
      "vite-plus/test/config",
      "expect-webdriverio"
    ]
  },
  "include": [
    "src/stopword.d.ts",
    "vite.config.ts",
    "e2e-browser/**/*.ts",
    "wdio*.conf.ts",
    "e2e-native/**/*.ts",
    "type-tests/**/*.ts",
    "e2e-server/**/*.ts"
  ],
  "exclude": [
    "dist",
    "build",
    "node_modules"
  ]
}
